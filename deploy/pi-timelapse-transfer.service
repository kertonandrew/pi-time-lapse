[Unit]
Description=Observe solar input and transfer a bounded photograph batch
After=network.target pi-hardware.service

[Service]
Type=oneshot
WorkingDirectory=/usr/local/lib/pi-timelapse
ExecStart=/usr/bin/python3 -m timelapse --config /etc/pi-timelapse.json probe
ExecStart=/usr/bin/python3 -m timelapse --config /etc/pi-timelapse.json upload
StateDirectory=pi-timelapse
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pi-timelapse
