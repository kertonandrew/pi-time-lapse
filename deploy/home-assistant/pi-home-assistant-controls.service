[Unit]
Description=Apply validated Home Assistant camera configuration
After=network.target pi-hardware.service
ConditionPathExists=/etc/pi-home-assistant/config.json
ConditionPathExists=/etc/pi-timelapse.json

[Service]
Type=oneshot
WorkingDirectory=/opt/pi-home-assistant
ExecStart=/opt/pi-home-assistant/.venv/bin/python -I -m timelapse.ha --config /etc/pi-home-assistant/config.json controls
StateDirectory=pi-home-assistant pi-timelapse-controls
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=40
KillMode=control-group
MemoryMax=64M
TasksMax=16
LimitNOFILE=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/pi-home-assistant /var/lib/pi-timelapse-controls
