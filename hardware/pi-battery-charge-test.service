[Unit]
Description=Run one provisional PiJuice charging trial
After=pijuice.service
Conflicts=pi-battery-test.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/default/pi-battery-charge-test
ExecStartPre=/usr/bin/systemctl restart pi-battery-charge-deadline.timer
ExecStart=/usr/bin/python3 -u /usr/local/lib/pi-time-lapse/charge_test.py run --output ${BATTERY_CHARGE_OUTPUT}
ExecStopPost=/usr/bin/python3 /usr/local/lib/pi-time-lapse/charge_test.py stop --output ${BATTERY_CHARGE_OUTPUT}
RuntimeMaxSec=6min
TimeoutStopSec=30s
KillMode=control-group
Restart=no
Nice=10
UMask=0077
